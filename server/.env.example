# Port the Express server listens on
PORT=3001

# OpenAI API key used to generate the evaluation report (required)
OPENAI_API_KEY=

# Model used for analysis (optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# GitHub personal access token (optional). Not required for public repos,
# but raises the GitHub API rate limit from 60 to 5000 requests/hour and is
# required to evaluate private repositories you have access to.
GITHUB_TOKEN=

# Comma-separated list of origins allowed to call this API (optional)
CORS_ORIGIN=http://localhost:5173
