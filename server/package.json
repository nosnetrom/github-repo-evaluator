    "dev": "node --use-system-ca --watch src/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "openai": "^4.68.0"
  },
  "engines": {
    "node": ">=22"
  }
}
